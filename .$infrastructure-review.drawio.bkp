        <mxCell id="review-rodney-dep" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#6F0000;fontFamily=Garamond;" value="&lt;b&gt;Rede do RODNEY&lt;/b&gt;&lt;br&gt;Mesma sub-rede: LAN direta.&lt;br&gt;Gateway/DNS e *arr via CORTANA.&lt;br&gt;Acesso externo somente via NPM.&lt;br&gt;Exeção: SSH para manutenção/monitoricação." vertex="1">
          <mxGeometry height="55" width="240" x="240.5" y="457.95" as="geometry" />
