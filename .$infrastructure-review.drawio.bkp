  </diagram>
  <diagram name="Políticas e acessos" id="review-policies">
    <mxGraphModel dx="900" dy="620" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p-title" value="Políticas e acessos" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontFamily=Garamond;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="820" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p-access" value="&lt;b&gt;Acesso — alvo&lt;/b&gt;&lt;br&gt;O Tailscale é uma rede sobreposta (overlay). O NPM é acessível somente pela tailnet; nenhuma porta está aberta para a Internet. O RODNEY &lt;b&gt;não&lt;/b&gt; deve ter nó Tailscale próprio: o acesso externo aos serviços dele é feito exclusivamente pelo NPM. O caminho previsto é Tailscale → CORTANA → UFW → NPM → serviço." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontFamily=Garamond;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="820" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p-ufw" value="&lt;b&gt;Estado atual × alvo&lt;/b&gt;&lt;br&gt;Hoje o Syncthing está sendo acessado pelo IP Tailscale do RODNEY. Isso exige um nó Tailscale no RODNEY e não é o desenho desejado. O alvo é remover esse acesso direto e publicar o Syncthing apenas pelo NPM. Enquanto o nó Tailscale existir, o tráfego entre peers pode ir direto/DERP e não passa pelo UFW da CORTANA; as ACLs do Tailscale controlam esse acesso. Na mesma sub-rede, o RODNEY também alcança outros hosts da LAN diretamente, sem passar pela CORTANA. O UFW da CORTANA protege os serviços dela, não é firewall do RODNEY." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontFamily=Garamond;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="820" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p-vpn" value="&lt;b&gt;VPN por serviço&lt;/b&gt;&lt;br&gt;Somente qBittorrent, Sonarr e os demais serviços *arr usam o Gluetun/Surfshark (no desenho, Gluetun na CORTANA). O restante do RODNEY não passa pela VPN. Confirmar se o Surfshark é usado apenas para saída." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontFamily=Garamond;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="415" width="820" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p-sync-intro" value="&lt;b&gt;Syncthing — estado atual × alvo&lt;/b&gt;&lt;br&gt;Atual: clientes acessam o Syncthing pelo IP Tailscale do RODNEY. Alvo: nenhum acesso direto; o Syncthing deve ser alcançado somente pelo NPM. Confirmar se o NPM consegue publicar o protocolo de sincronização (porta 22000/TCP e UDP), não apenas a interface web. Sincronização ponto a ponto não funciona atrás de um proxy HTTP convencional." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontFamily=Garamond;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="525" width="820" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p-cold" value="&lt;b&gt;cold-backup&lt;/b&gt; · somente recebe · não envia para clientes" style="text;html=1;whiteSpace=wrap;strokeColor=#82B366;fillColor=#F5F5F5;align=left;verticalAlign=middle;fontSize=12;fontFamily=Garamond;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="640" width="790" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p-drawings" value="&lt;b&gt;drawings&lt;/b&gt; · envia e recebe · arquivos apagados retidos por 1 ano" style="text;html=1;whiteSpace=wrap;strokeColor=#82B366;fillColor=#F5F5F5;align=left;verticalAlign=middle;fontSize=12;fontFamily=Garamond;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="675" width="790" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p-obsidian" value="&lt;b&gt;obsidian&lt;/b&gt; · envia e recebe · arquivos apagados retidos por 1 ano" style="text;html=1;whiteSpace=wrap;strokeColor=#82B366;fillColor=#F5F5F5;align=left;verticalAlign=middle;fontSize=12;fontFamily=Garamond;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="710" width="790" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p-projects" value="&lt;b&gt;local projects&lt;/b&gt; · envia e recebe · arquivos apagados não são retidos" style="text;html=1;whiteSpace=wrap;strokeColor=#82B366;fillColor=#F5F5F5;align=left;verticalAlign=middle;fontSize=12;fontFamily=Garamond;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="745" width="790" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
